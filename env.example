# PI TTS Pack settings — copy to .env and restart:  sudo systemctl restart pi-tts-pack

PIPER_PORT=5050
# API key (header X-API-Key, Bearer token, or ?key=) — always required from the internet (ngrok etc.)
# Internet access is refused while this is empty. PIPER_KEY_ON_LAN=true also requires it on the LAN.
PIPER_API_KEY=
PIPER_KEY_ON_LAN=false
PIPER_DEFAULT_VOICE=en_US-lessac-medium

# Whisper model for audio/video input: auto (base for English, small otherwise) | tiny | base | small | medium
WHISPER_MODEL=auto
WHISPER_THREADS=4

# Voice cloning: VieNeu-TTS (Vietnamese/English) + Pocket TTS (English/EU)
VIENEU_PRECISION=fp32
POCKET_QUANTIZE=true
CLONE_THREADS=4
CLONE_PRESETS=true
SUPERTONIC_STEPS=8

# Public https URL of this server (Cloudflare Tunnel / ngrok / Tailscale Funnel) — needed for Twilio
PUBLIC_BASE_URL=
# Extra Host headers allowed on /mcp (comma separated); "*" disables the check
PIPER_ALLOWED_HOSTS=

# Optional: outbound phone calls via Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
