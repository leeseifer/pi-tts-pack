[Unit]
Description=PI TTS Pack (TTS, voice changer, MCP server)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@PIPER_USER@
WorkingDirectory=@PIPER_DIR@
EnvironmentFile=-@PIPER_DIR@/.env
Environment=PYTHONUNBUFFERED=1
Environment=HF_HUB_DISABLE_TELEMETRY=1
ExecStart=@PIPER_DIR@/.venv/bin/python -m app.main
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
